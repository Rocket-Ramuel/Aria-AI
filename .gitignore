__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# Corpus + derived artifacts: reproducible with `python -m aria prepare`
data/raw/
data/corpus.txt
data/*.bin
data/chat.pt
data/tokenizer.json
data/meta.json

# Trained weights and everything the online learner accumulates. The learner
# writes next to its checkpoint, so for the shipped model that is
# checkpoints/online/ -- and replay.json/journal.jsonl hold your conversations
# in plain text, so no "online" directory anywhere is ever committed.
runs/
online/
*.pt
!tests/**/*.pt
# ...except the shipped model, so a fresh clone can talk to Aria immediately
!checkpoints/*.pt

# Training run logs
*.log
